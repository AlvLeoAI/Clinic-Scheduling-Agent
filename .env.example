# Replace the password placeholder consistently with a NEW local-only demo password.
# These databases contain synthetic data only. No vendor keys are needed unless AGENT_PROVIDER=openai.
POSTGRES_PASSWORD=<local_demo_password>
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://clinic_demo:<local_demo_password>@127.0.0.1:15432/clinic_scheduling_dev
TEST_DATABASE_URL=postgresql+psycopg://clinic_demo:<local_demo_password>@127.0.0.1:15433/clinic_scheduling_test
SESSION_TTL_HOURS=24

# Chat provider: disabled (default), demo (scripted, no network) or openai (paid; needs
# OPENAI_API_KEY and OPENAI_MODEL, and explicit approval before any live run).
AGENT_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
PROVIDER_TIMEOUT_SECONDS=30
TURN_LEASE_SECONDS=90
PROVIDER_MAX_OUTPUT_TOKENS=2048

# Days after session expiry before stored chat text is purged (python -m scripts.purge_chat).
CHAT_RETENTION_DAYS=30
