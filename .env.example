# Replace the password placeholder consistently with a NEW local-only demo password.
# These databases contain synthetic data only. No vendor keys are needed in M1.
POSTGRES_PASSWORD=<local_demo_password>
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://clinic_demo:<local_demo_password>@127.0.0.1:15432/clinic_scheduling_dev
TEST_DATABASE_URL=postgresql+psycopg://clinic_demo:<local_demo_password>@127.0.0.1:15432/clinic_scheduling_test
SESSION_TTL_HOURS=24

# M4 remains offline until a separate live-call approval and explicit configuration.
ENABLE_LIVE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=
PROVIDER_TIMEOUT_SECONDS=30
TURN_LEASE_SECONDS=90
PROVIDER_MAX_OUTPUT_TOKENS=2048
